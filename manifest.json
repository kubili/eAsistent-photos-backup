{
  "manifest_version": 3,
  "name": "eAsistent – fotografije iz vrtca",
  "version": "0.1.0",
  "description": "Shrani manjkajoče/vse fotografije v polni ločljivosti iz galerije eAsistenta v lokalno mapo.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://vrtec.easistent.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Varnostno kopiraj fotografije eAsistenta",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
